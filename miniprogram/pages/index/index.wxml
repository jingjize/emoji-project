<!--pages/index/index.wxml-->
<view class="container">
  <view class="header">
    <text class="title">🎭 AI表情盒子</text>
    <text class="subtitle">AI生成表情包、头像，智能解释网络黑话</text>
  </view>

  <!-- 标签页切换 -->
  <view class="tab-buttons">
    <view 
      class="tab-btn {{currentTab === 'upload' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="upload"
    >
      <text>📤 上传图片</text>
    </view>
    <view 
      class="tab-btn {{currentTab === 'gallery' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="gallery"
    >
      <text>🖼️ 图库选择</text>
    </view>
    <view 
      class="tab-btn {{currentTab === 'slang' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="slang"
    >
      <text>💬 黑话盒子</text>
    </view>
  </view>

  <!-- 上传图片标签页 -->
  <view class="tab-content" wx:if="{{currentTab === 'upload'}}">
    <!-- 上传区域 -->
    <view class="upload-area" bindtap="chooseImage">
    <image wx:if="{{previewImage}}" src="{{previewImage}}" class="preview-image" mode="aspectFit"></image>
    <view wx:else class="upload-placeholder">
      <text class="upload-icon">📸</text>
      <text class="upload-text">点击选择图片</text>
      <text class="upload-hint">支持 JPG、PNG 格式，最大 10MB</text>
    </view>
  </view>

  <!-- 文件信息 -->
  <view wx:if="{{fileInfo}}" class="file-info">{{fileInfo}}</view>

  <!-- 情绪选择 -->
      <!-- 图片风格选择 -->
      <view class="style-section">
        <view class="style-section-header" bindtap="toggleStyle">
          <text class="style-section-title">图片风格</text>
          <text class="style-section-arrow">{{styleExpanded ? '▼' : '▶'}}</text>
        </view>
        <view class="style-section-content" wx:if="{{styleExpanded}}">
          <scroll-view class="style-buttons-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
            <view class="style-buttons">
              <view 
                wx:for="{{imageStyles}}" 
                wx:key="code"
                class="style-btn {{selectedStyle === item.code ? 'active' : ''}}"
                bindtap="selectStyle"
                data-style="{{item.code}}"
              >
                <text class="style-text">{{item.name}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

  <view class="emotion-selector">
    <text class="emotion-label">选择情绪：</text>
    <view class="emotion-buttons">
      <view 
        wx:for="{{emotions}}" 
        wx:key="englishName"
        class="emotion-btn {{selectedEmotion === item.englishName ? 'active' : ''}}"
        bindtap="selectEmotion"
        data-emotion="{{item.englishName}}"
      >
        <text class="emotion-icon">{{item.icon}}</text>
        <text class="emotion-text">{{item.chineseName}}</text>
      </view>
    </view>
  </view>

  <!-- 自定义文字输入 -->
  <view class="text-input-area">
    <text class="text-input-label">自定义文字（可选）：</text>
    <input 
      class="text-input" 
      type="text" 
      placeholder="输入你想添加到图片上的文字，留空则不添加文字"
      value="{{customText}}"
      bindinput="onTextInput"
      maxlength="50"
    />
    <text class="text-input-hint">文字将显示在图片中间，支持自动换行</text>
  </view>

  <!-- 文字样式设置 -->
  <view class="style-section">
    <view class="style-section-header" bindtap="toggleTextStyle">
      <text class="style-section-title">文字样式设置</text>
      <text class="style-section-arrow">{{textStyleExpanded ? '▼' : '▶'}}</text>
    </view>
    <view class="style-section-content" wx:if="{{textStyleExpanded}}">
      <view class="style-row">
        <text class="style-label">文字位置：</text>
        <picker mode="selector" range="{{positionOptions}}" range-key="label" value="{{textPositionIndex}}" bindchange="onPositionChange">
          <view class="style-picker">{{positionOptions[textPositionIndex].label}}</view>
        </picker>
      </view>
      <view class="style-row">
        <text class="style-label">字体大小：</text>
        <slider 
          value="{{fontSize}}" 
          min="20" 
          max="100" 
          step="5"
          show-value
          bindchange="onFontSizeChange"
          activeColor="#667eea"
        />
      </view>
      <view class="style-row">
        <text class="style-label">文字颜色：</text>
        <view class="color-picker-wrapper">
          <view class="color-preview" style="background: rgb({{textColorRgb}})" bindtap="showColorPicker" data-type="text"></view>
          <input 
            class="color-input" 
            type="text" 
            value="{{textColorRgb}}" 
            placeholder="255,255,255"
            bindinput="onTextColorInput"
            maxlength="11"
          />
        </view>
      </view>
      <view class="style-row">
        <text class="style-label">描边颜色：</text>
        <view class="color-picker-wrapper">
          <view class="color-preview" style="background: rgb({{strokeColorRgb}})" bindtap="showColorPicker" data-type="stroke"></view>
          <input 
            class="color-input" 
            type="text" 
            value="{{strokeColorRgb}}" 
            placeholder="0,0,0"
            bindinput="onStrokeColorInput"
            maxlength="11"
          />
        </view>
      </view>
      <view class="style-row">
        <text class="style-label">描边宽度：</text>
        <slider 
          value="{{strokeWidth}}" 
          min="1" 
          max="10" 
          step="1"
          show-value
          bindchange="onStrokeWidthChange"
          activeColor="#667eea"
        />
      </view>
    </view>
  </view>

  <!-- 滤镜选择 -->
  <view class="style-section">
    <view class="style-section-header" bindtap="toggleFilter">
      <text class="style-section-title">滤镜效果</text>
      <text class="style-section-arrow">{{filterExpanded ? '▼' : '▶'}}</text>
    </view>
    <view class="style-section-content" wx:if="{{filterExpanded}}">
      <view class="filter-buttons">
        <view 
          wx:for="{{filters}}" 
          wx:key="code"
          class="filter-btn {{selectedFilter === item.code ? 'active' : ''}}"
          bindtap="selectFilter"
          data-filter="{{item.code}}"
        >
          <text class="filter-text">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 生成按钮 -->
  <button 
    class="generate-btn {{canGenerate ? '' : 'disabled'}}" 
    bindtap="generateMeme"
    disabled="{{!canGenerate || loading}}"
  >
    {{loading ? '生成中...' : '生成情绪表情'}}
  </button>

  <!-- 加载提示 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">AI 正在生成情绪表情图片...</text>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <!-- 结果展示 -->
  <view wx:if="{{resultImageUrl}}" class="result-area result-container">
    <text class="result-title">✨ {{resultEmotion}}表情生成完成！</text>
    <image src="{{resultImageUrl}}" class="result-image" mode="aspectFit" bindtap="previewImage"></image>
    
    <!-- 分享按钮区域 -->
    <view class="action-buttons">
      <button class="action-btn primary" bindtap="shareToWeChat">
        <text class="btn-icon">💬</text>
        <text>分享到微信</text>
      </button>
      <button class="action-btn" bindtap="saveImage">
        <text class="btn-icon">💾</text>
        <text>保存到相册</text>
      </button>
    </view>
    
    <button class="action-btn secondary" bindtap="reset">重新生成</button>
    
    <!-- 分享提示 -->
    <view class="share-tips">
      <text class="tip-text">👉 点击右上角「···」也可以直接转发给好友</text>
    </view>
  </view>
  </view>

  <!-- 图库选择标签页 -->
  <view class="tab-content" wx:if="{{currentTab === 'gallery'}}">
    <!-- 搜索区域 -->
    <view class="gallery-search">
      <view class="search-input-wrapper">
        <input 
          class="search-input" 
          type="text" 
          placeholder="搜索图片（如：猫、风景、人物）"
          value="{{gallerySearchQuery}}"
          bindinput="onGallerySearchInput"
          confirm-type="search"
          bindconfirm="searchGallery"
        />
        <button class="search-btn" bindtap="searchGallery">搜索</button>
      </view>
      <scroll-view class="category-scroll" scroll-x="true">
        <view class="category-buttons">
          <view 
            wx:for="{{galleryCategories}}" 
            wx:key="code"
            class="category-btn {{galleryCurrentCategory === item.code ? 'active' : ''}}"
            bindtap="selectGalleryCategory"
            data-category="{{item.code}}"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 图片网格 -->
    <scroll-view 
      class="gallery-scroll" 
      scroll-y="true" 
      lower-threshold="100"
      bindscrolltolower="loadMoreGallery"
    >
      <view class="gallery-grid">
        <view 
          wx:for="{{galleryImages}}" 
          wx:key="id"
          class="gallery-item {{selectedGalleryImage === item.originalUrl ? 'selected' : ''}}"
          bindtap="selectGalleryImage"
          data-url="{{item.originalUrl}}"
        >
          <image 
            src="{{item.smallUrl || item.mediumUrl || item.originalUrl}}" 
            mode="aspectFill"
            lazy-load
          />
        </view>
      </view>
      <view wx:if="{{galleryLoading}}" class="gallery-loading">
        <text>加载中...</text>
      </view>
      <view wx:if="{{galleryImages.length === 0 && !galleryLoading}}" class="gallery-empty">
        <text>暂无图片，请尝试搜索或选择分类</text>
      </view>
    </scroll-view>
  </view>

  <!-- 黑话盒子标签页 -->
  <view class="tab-content" wx:if="{{currentTab === 'slang'}}">
    <view class="slang-box">
      <view class="slang-header">
        <text class="slang-title">💬 黑话盒子</text>
        <text class="slang-hint">输入互联网黑话或网络用语，AI 帮你解释含义、来源和使用场景</text>
      </view>
      <view class="slang-input-area">
        <view class="slang-input-wrapper">
          <input 
            class="slang-input" 
            type="text" 
            placeholder="输入词语，如：yyds、破防、内卷..."
            value="{{slangWord}}"
            bindinput="onSlangInput"
            confirm-type="search"
            bindconfirm="explainSlang"
            maxlength="50"
          />
          <button class="slang-search-btn" bindtap="explainSlang" disabled="{{slangLoading}}">
            {{slangLoading ? '解释中...' : '解释'}}
          </button>
          <button 
            class="slang-refresh-btn" 
            bindtap="refreshHotSlangs"
            disabled="{{slangRefreshing}}"
            size="mini"
          >
            <text>{{slangRefreshing ? '刷新中...' : '↻'}}</text>
          </button>
        </view>
        <view class="slang-examples-wrapper">
          <view class="slang-examples-header">
            <text class="slang-examples-label">热门词语：</text>
          </view>
          <view class="slang-examples">
            <text wx:if="{{slangExamples.length === 0}}" class="slang-loading-text">加载中...</text>
            <view 
              wx:for="{{slangExamples}}" 
              wx:key="index"
              wx:for-item="word"
              class="slang-example-tag"
              bindtap="selectSlangExample"
              data-word="{{word}}"
            >
              {{word}}
            </view>
          </view>
        </view>
        <view class="slang-industry-wrapper">
          <view class="slang-industry-header">
            <text class="slang-industry-label">选择行业：</text>
          </view>
          <view class="slang-industry-buttons {{industryExpanded ? 'expanded' : ''}}">
            <view 
              wx:for="{{industries}}" 
              wx:key="index"
              wx:for-item="item"
              wx:if="{{!item.hidden || industryExpanded}}"
              class="slang-industry-btn {{selectedIndustry === item.code ? 'active' : ''}}"
              bindtap="selectIndustry"
              data-industry="{{item.code}}"
            >
              <text>{{item.name}}</text>
            </view>
          </view>
          <view class="slang-industry-toggle" bindtap="toggleIndustryExpand">
            <text class="slang-industry-icon">{{industryExpanded ? '收起 ▲' : '展开更多 ▼'}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{slangResult}}" class="slang-result">
        <view class="slang-word">{{slangWord}}</view>
        <view class="slang-short-explanation">{{slangShortExplanation}}</view>
        <view wx:if="{{slangDetailedExplanation}}" class="slang-toggle">
          <button 
            class="slang-toggle-btn" 
            bindtap="toggleDetailedExplanation"
            size="mini"
          >
            {{showDetailed ? '收起详细说明 ▲' : '查看详细说明 ▼'}}
          </button>
        </view>
        <view 
          wx:if="{{showDetailed && slangDetailedExplanation}}" 
          class="slang-detailed-explanation"
        >
          <text class="slang-detailed-text">{{slangDetailedExplanation}}</text>
        </view>
      </view>
      <view wx:if="{{slangLoading}}" class="slang-loading">
        <view class="loading-spinner"></view>
        <text class="loading-text">AI 正在分析中...</text>
      </view>
    </view>
  </view>
  
  <!-- 作者信息 -->
  <view class="footer-info">
    <text>作者：芝麻丸</text>
    <text>联系方式：15625735770</text>
  </view>
</view>

